<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefWidth="1672.0"
            prefHeight="941.0"
            stylesheets="@style-jeu.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projetihm.application.Controllers.MenuController">

    <!-- Image de fond de la page d'accueil -->
    <ImageView fitWidth="1672.0"
               fitHeight="941.0"
               preserveRatio="false">
        <image>
            <Image url="@images/acceuil_VF_corrige.png"/>
        </image>
    </ImageView>

    <!-- Bouton Nouvelle Partie : légèrement descendu -->
    <Button layoutX="600.0"
            layoutY="555.0"
            prefWidth="470.0"
            prefHeight="74.0"
            text="NOUVELLE PARTIE"
            onAction="#onNouvellePartieClick"
            styleClass="menu-green-button"
            style="-fx-font-size: 26px;" />

    <!-- Bouton Règles du jeu même style, aligné avec le bouton du dessus -->
    <Button layoutX="600.0"
            layoutY="650.0"
            prefWidth="470.0"
            prefHeight="74.0"
            text="RÈGLES DU JEU"
            onAction="#onReglesClick"
            styleClass="menu-blue-button"
            style="-fx-font-size: 26px;" />

</AnchorPane>
