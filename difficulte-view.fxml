<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefWidth="1672.0"
            prefHeight="941.0"
            stylesheets="@style-jeu.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projetihm.application.Controllers.DifficulteController">

    <ImageView fitWidth="1672.0"
               fitHeight="941.0"
               preserveRatio="false">
        <image>
            <Image url="@images/acceuil_VF_corrige.png"/>
        </image>
    </ImageView>

    <AnchorPane layoutX="250.0"
                layoutY="405.0"
                prefWidth="1172.0"
                prefHeight="230.0"
                styleClass="difficulty-panel">

        <Label text="DIFFICULTE"
               layoutX="0.0"
               layoutY="0.0"
               prefWidth="1172.0"
               prefHeight="54.0"
               alignment="CENTER"
               styleClass="difficulty-screen-title"/>

        <Button text="FACILE 20:00"
                layoutX="0.0"
                layoutY="92.0"
                prefWidth="344.0"
                prefHeight="76.0"
                onAction="#choisirFacile"
                style="-fx-background-color: linear-gradient(#77dc77, #239d44); -fx-border-color: #12652a; -fx-text-fill: white; -fx-font-family: Arial; -fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 18; -fx-border-radius: 18; -fx-border-width: 4; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.34), 10, 0.22, 0, 4);"/>

        <Button text="NORMAL 15:00"
                layoutX="414.0"
                layoutY="92.0"
                prefWidth="344.0"
                prefHeight="76.0"
                onAction="#choisirNormal"
                style="-fx-background-color: linear-gradient(#ffe86a, #e2aa18); -fx-border-color: #9a6b00; -fx-text-fill: #12395c; -fx-font-family: Arial; -fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 18; -fx-border-radius: 18; -fx-border-width: 4; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.34), 10, 0.22, 0, 4);"/>

        <Button text="DIFFICILE 10:00"
                layoutX="828.0"
                layoutY="92.0"
                prefWidth="344.0"
                prefHeight="76.0"
                onAction="#choisirDifficile"
                style="-fx-background-color: linear-gradient(#ff7676, #c93333); -fx-border-color: #7e1717; -fx-text-fill: white; -fx-font-family: Arial; -fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 18; -fx-border-radius: 18; -fx-border-width: 4; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.34), 10, 0.22, 0, 4);"/>

        <Button text="RETOUR"
                layoutX="506.0"
                layoutY="188.0"
                prefWidth="160.0"
                prefHeight="42.0"
                onAction="#retourMenu"
                styleClass="difficulty-back-button"/>
    </AnchorPane>
</AnchorPane>
