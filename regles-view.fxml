<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefWidth="1672.0"
            prefHeight="941.0"
            stylesheets="@style-jeu.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projetihm.application.Controllers.ReglesController">

    <!-- Image de fond contenant les règles du jeu -->
    <ImageView fitWidth="1672.0"
               fitHeight="941.0"
               preserveRatio="false">
        <image>
            <Image url="@images/regles_VF.png"/>
        </image>
    </ImageView>

    <!-- Bouton retour plus grand, avec texte blanc -->
    <Button layoutX="70.0"
            layoutY="810.0"
            prefWidth="255.0"
            prefHeight="72.0"
            text="RETOUR"
            onAction="#onRetourClick"
            styleClass="back-button"
            style="-fx-font-size: 24px;" />

</AnchorPane>
